<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.irontrail.railtechrh.controller.LoginController" spacing="10" styleClass="vbox">
    <stylesheets>
        <URL value="@style/login.css" /> <!-- Lien vers le fichier CSS -->
    </stylesheets>

    <!-- Titre "Connexion" -->
    <Label text="Connectez-vous" styleClass="label-title" />

    <!-- Champ de texte pour l'email -->
    <TextField fx:id="emailField" promptText="Email" styleClass="text-field" />

    <!-- Champ de texte pour le mot de passe -->
    <PasswordField fx:id="motDePasseField" promptText="Mot de passe" styleClass="password-field" />

    <!-- Bouton "Se connecter" -->
    <Button text="Se connecter" onAction="#handleConnexion" styleClass="button" />

    <!-- Label pour les messages d'erreur -->
    <Label fx:id="errorLabel" styleClass="error-label" />
</VBox>