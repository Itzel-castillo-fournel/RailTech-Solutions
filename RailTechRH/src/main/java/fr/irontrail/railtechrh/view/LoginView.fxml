<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.irontrail.railtechrh.controller.LoginController" spacing="10" padding="10">
    <Label text="Connexion"/>
    <TextField fx:id="emailField" promptText="Email"/>
    <PasswordField fx:id="motDePasseField" promptText="Mot de passe"/>
    <Button text="Se connecter" onAction="#handleConnexion"/>
    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
</VBox>