<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20" style="-fx-background-color: #EEF1F6; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.irontrail.railtechrh.controller.ExamenController">
    <Label style="-fx-font-size: 32; -fx-text-fill: #1a237e; -fx-font-weight: bold;" text="Titre">
        <font>
            <Font name="Konkhmer Sleokchher" size="24.0" />
        </font>
    </Label>

    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
        <VBox spacing="10">
            <Label style="-fx-font-size: 14; -fx-text-fill: #4051b5; -fx-font-family: 'Konkhmer Sleokchher'; -fx-font-weight: bold;" text="Libelle" />
            <PasswordField fx:id="currentPasswordField" prefHeight="40" style="-fx-background-radius: 5;" />
        </VBox>

        <VBox spacing="10">
            <Label style="-fx-font-size: 14; -fx-text-fill: #4051b5; -fx-font-family: 'Konkhmer Sleokchher'; -fx-font-weight: bold;" text="Libelle" />
            <PasswordField fx:id="newPasswordField" prefHeight="40" style="-fx-background-radius: 5;" />
        </VBox>

        <VBox spacing="10">
            <Label style="-fx-font-size: 14; -fx-text-fill: #4051b5; -fx-font-family: 'Konkhmer Sleokchher'; -fx-font-weight: bold;" text="Libelle" />
            <PasswordField fx:id="confirmPasswordField" prefHeight="40" style="-fx-background-radius: 5;" />
        </VBox>

        <Label fx:id="statusLabel" style="-fx-font-size: 14; -fx-text-fill: red; -fx-font-family: 'Konkhmer Sleokchher';" />

        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Button fx:id="Button"  style="-fx-background-color: #ff5252; -fx-text-fill: white; -fx-background-radius: 8px; -fx-font-family: 'Konkhmer Sleokchher'; -fx-font-weight: bold; -fx-padding: 10 20;" text="ANNULER">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Button>
            <Button fx:id="Button2"  style="-fx-background-color: #1C287C; -fx-text-fill: white; -fx-background-radius: 8px; -fx-font-family: 'Konkhmer Sleokchher'; -fx-font-weight: bold; -fx-padding: 10 20;" text="ENREGISTRER">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Button>
        </HBox>
    </VBox>
</VBox>
