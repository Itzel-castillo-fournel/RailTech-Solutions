<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.irontrail.railtechrh.controller.PlanningController"
      style="-fx-background-color: #f5f7ff;">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Mon Planning"
           style="-fx-font-size: 32px; -fx-text-fill: #1a237e; -fx-font-weight: bold;">
        <VBox.margin>
            <Insets bottom="30"/>
        </VBox.margin>
    </Label>

    <HBox alignment="CENTER_LEFT" spacing="250">
        <Label text="Mes Trajets du Jour"
               style="-fx-font-size: 24px; -fx-text-fill: #1a237e; -fx-font-weight: bold;"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="previousDateButton" text="&lt;"
                    style="-fx-background-color: transparent; -fx-text-fill: #1a237e; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="dateLabel" style="-fx-font-size: 18px; -fx-text-fill: #1a237e;"/>
            <Button fx:id="nextDateButton" text="&gt;"
                    style="-fx-background-color: transparent; -fx-text-fill: #1a237e; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox.margin>
            <Insets top="20"/>
        </VBox.margin>
        <VBox fx:id="trajetsContainer" spacing="20"/>
    </ScrollPane>
</VBox>