<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.irontrail.railtechrh.controller.operateur.PlanningController">
    <VBox fx:id="mainContainer" prefHeight="600.0" prefWidth="800.0" spacing="15" style="-fx-padding: 20; -fx-background-color: #EEF1F6;">
        <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="760.0">
            <Label prefHeight="40.0" prefWidth="590.0" style="-fx-font-weight: bold; -fx-font-size: 32px; -fx-text-fill: #1a237e;" text="Planning conducteurs" textFill="#1a237e">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
                <HBox.margin>
                    <Insets right="50.0" />
                </HBox.margin>
            </Label>
            <Button fx:id="b_onClickAddTrajet" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="39.0" prefWidth="100.0" style="-fx-background-color: #1C287C; -fx-border-radius: 8px; -fx-background-radius: 8px;" text="AJOUTER" textAlignment="CENTER" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="15.0" />
                </font>
            </Button>
        </HBox>

        <Pane minWidth="-Infinity" prefHeight="50.0" prefWidth="760.0">
            <children>
                <ChoiceBox fx:id="cb_conducteur" layoutY="5.0" prefHeight="25.0" prefWidth="215.0" style="-fx-background-color: transparent; -fx-border-color: #1c287c; -fx-border-radius: 5px; -fx-pref-height: 40px; -fx-pref-width: 220px;" />
                <ChoiceBox fx:id="cb_semaine" layoutX="540.0" layoutY="5.0" prefHeight="25.0" prefWidth="215.0" style="-fx-background-color: transparent; -fx-border-color: #1c287c; -fx-border-radius: 5px; -fx-pref-height: 40px; -fx-pref-width: 220px;" />
            </children>
        </Pane>

        <!-- Label pour afficher un message lorsqu'aucun trajet n'est trouvé -->
        <Label fx:id="noTrajetsLabel" style="-fx-text-fill: red; -fx-font-size: 14; -fx-font-weight: bold;" text="" visible="false" />

        <!-- Conteneur du planning -->
        <GridPane fx:id="planningGrid" alignment="CENTER" hgap="1.0" prefHeight="420.0" prefWidth="760.0" style="-fx-background-color: #E8EBF3; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #2D45C9; -fx-border-width: 1;" vgap="1.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="40.0" prefHeight="45.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="375.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" text="Lundi" textFill="#2d45c9" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" contentDisplay="CENTER" text="Mardi" textFill="#2d45c9" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" contentDisplay="CENTER" text="Mercredi" textFill="#2d45c9" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" contentDisplay="CENTER" text="Jeudi" textFill="#2d45c9" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" contentDisplay="CENTER" text="Vendredi" textFill="#2d45c9" GridPane.columnIndex="4" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" contentDisplay="CENTER" text="Samedi" textFill="#2d45c9" GridPane.columnIndex="5" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" contentDisplay="CENTER" text="Dimanche" textFill="#2d45c9" GridPane.columnIndex="6" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <VBox fx:id="lundiContainer" spacing="10" style="-fx-padding: 5; -fx-background-color: white;" GridPane.rowIndex="1">
                    <!-- Les trajets du lundi seront ajoutés ici dynamiquement -->
                </VBox>

                <VBox fx:id="mardiContainer" spacing="10" style="-fx-padding: 5; -fx-background-color: white;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <!-- Les trajets du mardi seront ajoutés ici dynamiquement -->
                </VBox>

                <VBox fx:id="mercrediContainer" spacing="10" style="-fx-padding: 5; -fx-background-color: white;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <!-- Les trajets du mercredi seront ajoutés ici dynamiquement -->
                </VBox>

                <VBox fx:id="jeudiContainer" spacing="10" style="-fx-padding: 5; -fx-background-color: white;" GridPane.columnIndex="3" GridPane.rowIndex="1">
                    <!-- Les trajets du jeudi seront ajoutés ici dynamiquement -->
                </VBox>

                <VBox fx:id="vendrediContainer" spacing="10" style="-fx-padding: 5; -fx-background-color: white;" GridPane.columnIndex="4" GridPane.rowIndex="1">
                    <!-- Les trajets du vendredi seront ajoutés ici dynamiquement -->
                </VBox>

                <VBox fx:id="samediContainer" spacing="10" style="-fx-padding: 5; -fx-background-color: white;" GridPane.columnIndex="5" GridPane.rowIndex="1">
                    <!-- Les trajets du samedi seront ajoutés ici dynamiquement -->
                </VBox>

                <VBox fx:id="dimancheContainer" spacing="10" style="-fx-padding: 5; -fx-background-color: white;" GridPane.columnIndex="6" GridPane.rowIndex="1">
                    <!-- Les trajets du dimanche seront ajoutés ici dynamiquement -->
                </VBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </GridPane>
    </VBox>
</ScrollPane>
