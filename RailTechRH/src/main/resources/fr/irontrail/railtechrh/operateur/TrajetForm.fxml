    <Button fx:id="b_addTrajet" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#b_onClickAddTrajet" prefHeight="39.0" prefWidth="658.0" style="-fx-background-color: #1C287C;" text="Créer le trajet" textAlignment="CENTER" textFill="#fcfafa">
